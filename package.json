{
  "name": "tabbycat",
  "version": "0.0.1",
  "private": true,
  "description": "Tabbycat — Electron + Nuxt rewrite of TuxGuitar",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "node scripts/dev.mjs",
    "generate": "pnpm run icons && nuxt generate",
    "build": "pnpm run generate",
    "preview": "pnpm run generate && electron .",
    "smoke": "pnpm run generate && node scripts/smoke.mjs",
    "dist": "pnpm run generate && electron-builder --mac",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "test:audio": "dotnet run --project sidecar/tests/AudioTests.csproj --configuration Release && node --test test/audio-sidecar.test.mjs",
    "ai:tgx": "node scripts/ai/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run generate && node test/e2e/editor.mjs && node test/e2e/rhythm.mjs && node test/e2e/tab-engine.mjs && node test/e2e/engraving.mjs && node test/e2e/repeats.mjs && node test/e2e/repeat-writing.mjs && node test/e2e/technique-writing.mjs && node test/e2e/articulation-playback.mjs && node test/e2e/tab-design.mjs",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.check.json",
    "build:packages": "pnpm --filter @coderline/alphatab build",
    "postinstall": "pnpm run build:packages && nuxt prepare"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "25.9.1",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "nuxt-electron": "^0.7.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.2.1",
    "typescript": "6.0.3",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@coderline/alphatab": "workspace:*",
    "@coderline/alphatab-vite": "^1.8.3",
    "@phosphor-icons/vue": "^2.2.1",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.6",
    "reka-ui": "^2.9.9",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "main": "dist-electron/main.js"
}
